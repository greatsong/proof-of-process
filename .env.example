# === Server-side (Vercel Edge Functions) ===
# AI 평가용 API 키 (서버에서만 사용, 클라이언트에 노출되지 않음)
GEMINI_API_KEY=your_gemini_api_key
CLAUDE_API_KEY=your_claude_api_key
OPENAI_API_KEY=your_openai_api_key

# PIN 입력 시 서버 키 사용 권한 부여 (서버사이드)
SECRET_API_PIN=your_secret_pin

# === Client-side (Vite - VITE_ prefix) ===
# 관리자 비밀번호 초기값
VITE_ADMIN_PASSWORD=your_admin_password

# 채팅 앱(ai-chat-for-students) 공유 API 베이스 URL
# "평가받기"로 넘어온 대화를 불러올 때 호출. 비워두면 프로덕션 기본값 사용.
# 학교망 SNI 차단 회피를 위해 Railway 직접 주소가 아니라 Vercel 도메인을 사용할 것.
VITE_CHAT_API_URL=https://danggok-ai.vercel.app/api/share
